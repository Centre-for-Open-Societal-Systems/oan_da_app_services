  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "SSO Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usr}}\",\n  \"password\": \"{{pwd}}\",\n  \"key\": \"{{sso_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/sso/login",
            "description": "Required login. POST /api/v1/da-services/sso/login with username, password, key (IAM login key, e.g. agent). Stores access_token and csrf_token. If `user` is empty, copies `usr` into `user` for plan bodies (DA self-plan). Override `user` when a Supervisor plans for another DA. On 401, re-run SSO Login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"SSO Login returns 200\", function () { pm.response.to.have.status(200); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "pm.test(\"SSO Login returns access_token\", function () {",
                  "    pm.expect(data.access_token, \"data.access_token\").to.be.a(\"string\").and.not.empty;",
                  "});",
                  "function save(key, value) {",
                  "    if (!value) return;",
                  "    pm.collectionVariables.set(key, value);",
                  "    if (pm.environment.name) pm.environment.set(key, value);",
                  "}",
                  "save(\"access_token\", data.access_token);",
                  "save(\"csrf_token\", data.csrf_token);",
                  "// Plan bodies need the Frappe User Link from whoami (often *@iam.internal), not the Keycloak username.",
                  "const who = data.user || {};",
                  "const frappeUser = who.user || who.email || who.name;",
                  "if (frappeUser) {",
                  "  save(\"user\", frappeUser);",
                  "} else {",
                  "  const usr = pm.environment.get(\"usr\") || pm.collectionVariables.get(\"usr\");",
                  "  const existingUser = pm.environment.get(\"user\") || pm.collectionVariables.get(\"user\");",
                  "  if (usr && !existingUser) save(\"user\", usr);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "1. Farmer check (optional before plan / link)",
      "description": "Recommended before scheduling: confirm the farmer is visible to the caller. Profile resolves FR-… to the registry internal id and enforces scope (DA must be linked / in assigned kebele; Supervisor/Executive by geography).",
      "item": [
        {
          "name": "Get farmer profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/farmers/{{farmer_id}}/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "farmers",
                "{{farmer_id}}",
                "profile"
              ]
            },
            "description": "Path: farmer_id (FR-… or registry internal id).\n\nUses Farmer Registry via DA Farmer Reference cache. Returns profile + is_linked + last visit.\n\nDependency: farmer must be syncable into DA Farmer Reference; caller must have scope."
          },
          "response": []
        },
        {
          "name": "Get farmer permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/farmers/{{farmer_id}}/permissions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "farmers",
                "{{farmer_id}}",
                "permissions"
              ]
            },
            "description": "Returns can_edit, is_linked, link_type for this farmer."
          },
          "response": []
        },
        {
          "name": "Get farmer visit history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/farmers/{{farmer_id}}/visits?limit=50&start=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "farmers",
                "{{farmer_id}}",
                "visits"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Page size (default 50)"
                },
                {
                  "key": "start",
                  "value": "0",
                  "description": "Offset (default 0)"
                }
              ]
            },
            "description": "Visit history for one farmer. First loads farmer profile for scope check (registry/cache)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Farmer links (Manual kebele mode)",
      "description": "Only when DA Kebele Assignment mode=Manual. Supervisor/Admin. Farmer must be in DA Farmer Reference, APPROVED, same Kebele as the DA.",
      "item": [
        {
          "name": "Create farmer link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"da_id\": \"{{da_id}}\",\n  \"farmer_id\": \"{{farmer_id}}\",\n  \"client_op_id\": \"{{client_op_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/farmer-links",
            "description": "Body:\n- da_id (required) — DA with Effective Manual kebele assignment\n- farmer_id (required) — must exist in DA Farmer Reference\n- client_op_id (optional) — idempotency key\n\nRoles: Supervisor, Admin.\n\nDoes not call live Farmer Registry; validates against DA Farmer Reference + Kebele assignment."
          },
          "response": []
        },
        {
          "name": "List farmer links",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/farmer-links?da_id={{da_id}}&farmer_id={{farmer_id}}&link_type=Manual&is_active=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "farmer-links"
              ],
              "query": [
                {
                  "key": "da_id",
                  "value": "{{da_id}}",
                  "description": "Filter by DA"
                },
                {
                  "key": "farmer_id",
                  "value": "{{farmer_id}}",
                  "description": "Filter by farmer"
                },
                {
                  "key": "link_type",
                  "value": "Manual",
                  "description": "Automatic | Manual"
                },
                {
                  "key": "is_active",
                  "value": "true",
                  "description": "default true when omitted in service"
                }
              ]
            },
            "description": "Roles: Supervisor, Admin, DA."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Plan and manage visits",
      "item": [
        {
          "name": "Plan a visit (scheduled_at)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "const lifeFarmer = \"FRM-POSTMAN-LIFE-\" + stamp;",
                  "pm.collectionVariables.set(\"client_op_id\", \"visit-\" + stamp);",
                  "pm.collectionVariables.set(\"farmer_id\", lifeFarmer);",
                  "if (pm.environment.name) {",
                  "  pm.environment.set(\"client_op_id\", \"visit-\" + stamp);",
                  "  pm.environment.set(\"farmer_id\", lifeFarmer);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Plan returns 201 or 200\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "const data = (pm.response.json() || {}).data || {};",
                  "const visitId = data.name || data.id;",
                  "if (visitId) {",
                  "  pm.collectionVariables.set(\"visit_id\", visitId);",
                  "  if (pm.environment.name) pm.environment.set(\"visit_id\", visitId);",
                  "}",
                  "if (data.da_id) {",
                  "  pm.collectionVariables.set(\"da_id\", data.da_id);",
                  "  if (pm.environment.name) pm.environment.set(\"da_id\", data.da_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmer_id\": \"{{farmer_id}}\",\n  \"user\": \"{{user}}\",\n  \"scheduled_at\": \"{{scheduled_at}}\",\n  \"visit_type\": \"Crop Survey\",\n  \"purpose\": \"Field check — crop stand and input uptake\",\n  \"duration_min\": 45,\n  \"priority\": \"Medium\",\n  \"priority_reason\": \"Routine seasonal follow-up\",\n  \"plot_ref\": \"BT-0472\",\n  \"location\": {\n    \"lat\": 9.0320,\n    \"lng\": 38.7469\n  },\n  \"notify_farmer_sms\": false,\n  \"da_id\": \"{{da_id}}\",\n  \"client_op_id\": \"{{client_op_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/visits",
            "description": "POST /visits — plan a visit (201).\n\n### Body fields\n| Field | Required | Notes |\n| --- | --- | --- |\n| farmer_id | yes | FR-… or registry id; **not** verified against Farmer Registry today |\n| user | yes | Frappe User name (email) for the assigned DA; da_id is fetched from User.da_registry_id. No session-user fallback |\n| scheduled_at | yes* | Site-local datetime; *or* use date + time |\n| date, time | alt | Form style; time defaults to 09:00 |\n| visit_type | no | Crop Survey / Livestock Survey / Services / Advisory / Follow-up (default Crop Survey) |\n| purpose | no | |\n| duration_min | no | default 45 |\n| priority | no | Low / Medium / High (default Medium) |\n| priority_reason | no | |\n| plot_ref | no | |\n| location | no | { lat, lng } |\n| notify_farmer_sms | no | recorded; SMS gateway not yet wired |\n| advisory_qa | no | Advisory visits only: [{ question, answer }] |\n| da_id | Supervisor | when Supervisor plans for a DA; DA self-plans omit or own id |\n| client_op_id | no | idempotency — same key returns existing visit |\n\nCreate allowed by DA Visit DocType permissions (DA / Supervisor / Admin).\n\nSet `user` in the environment (often same as `usr` for DA self-plan). Omitting `user` → validation error.\n\nStores visit_id from response `data.name`."
          },
          "response": []
        },
        {
          "name": "Plan a visit (date + time)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set(\"client_op_id\", \"visit-date-\" + stamp);",
                  "pm.collectionVariables.set(\"adv_farmer_id\", \"FRM-POSTMAN-ADV-\" + stamp);",
                  "if (pm.environment.name) {",
                  "  pm.environment.set(\"client_op_id\", \"visit-date-\" + stamp);",
                  "  pm.environment.set(\"adv_farmer_id\", \"FRM-POSTMAN-ADV-\" + stamp);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Plan date+time returns 201 or 200\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmer_id\": \"{{adv_farmer_id}}\",\n  \"user\": \"{{user}}\",\n  \"date\": \"{{visit_date}}\",\n  \"time\": \"10:00\",\n  \"visit_type\": \"Advisory\",\n  \"purpose\": \"Advisory Q&A on fertilizer timing\",\n  \"duration_min\": 30,\n  \"priority\": \"High\",\n  \"priority_reason\": \"Overdue advisory\",\n  \"notify_farmer_sms\": true,\n  \"advisory_qa\": [\n    {\n      \"question\": \"When should top-dressing be applied?\",\n      \"answer\": \"At tillering, if moisture is adequate.\"\n    }\n  ],\n  \"client_op_id\": \"{{client_op_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/visits",
            "description": "Same as Plan a visit, using separate date + time instead of scheduled_at. Uses a distinct farmer_id so it does not conflict with the lifecycle visit. Does not overwrite visit_id."
          },
          "response": []
        },
        {
          "name": "Plan visits batch (up to 5)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set(\"client_op_id\", \"batch-\" + stamp);",
                  "pm.collectionVariables.set(\"batch_farmer_id\", \"FRM-POSTMAN-BATCH-\" + stamp);",
                  "if (pm.environment.name) {",
                  "  pm.environment.set(\"client_op_id\", \"batch-\" + stamp);",
                  "  pm.environment.set(\"batch_farmer_id\", \"FRM-POSTMAN-BATCH-\" + stamp);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Batch plan creates at least one visit\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "  const data = (pm.response.json() || {}).data || {};",
                  "  pm.expect(data.created || []).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"{{user}}\",\n  \"visits\": [\n    {\n      \"farmer_id\": \"{{batch_farmer_id}}\",\n      \"date\": \"{{visit_date}}\",\n      \"time\": \"11:00\",\n      \"visit_type\": \"Crop Survey\",\n      \"purpose\": \"Batch plan item\",\n      \"duration_min\": 45,\n      \"priority\": \"Medium\",\n      \"client_op_id\": \"{{client_op_id}}-a\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/visits",
            "description": "Batch plan on the same POST /visits route (`visits: [...]`, length 1-5, unique farmer_id). Envelope `user` (required User Link) applies when an item omits `user`. Add more objects in `visits` for multi-farmer runs. Response: `{ created[], failed[], summary }`. Partial success: HTTP 201 if any created; 400 if none. No session-user fallback. Supervisors may also send envelope `da_id`."
          },
          "response": []
        },
        {
          "name": "List visits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/visits?from={{visit_date}}&to={{visit_date}}&farmer_id={{farmer_id}}&da_id={{da_id}}&limit=50&start=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "visits"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "",
                  "description": "Single calendar day (alternative to from/to). Use today for today's plan.",
                  "disabled": true
                },
                {
                  "key": "from",
                  "value": "{{visit_date}}",
                  "description": "Range start date"
                },
                {
                  "key": "to",
                  "value": "{{visit_date}}",
                  "description": "Range end date"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "physical_status filter e.g. Planned, In progress, Physical Visit Complete",
                  "disabled": true
                },
                {
                  "key": "farmer_id",
                  "value": "{{farmer_id}}",
                  "description": "Filter by farmer"
                },
                {
                  "key": "da_id",
                  "value": "{{da_id}}",
                  "description": "Filter by DA (Supervisor/Executive)"
                },
                {
                  "key": "region",
                  "value": "",
                  "description": "Optional equality filter on visit.region (within permitted rows)",
                  "disabled": true
                },
                {
                  "key": "zone",
                  "value": "",
                  "description": "Optional equality filter on visit.zone",
                  "disabled": true
                },
                {
                  "key": "woreda",
                  "value": "",
                  "description": "Optional equality filter on visit.woreda",
                  "disabled": true
                },
                {
                  "key": "kebele",
                  "value": "",
                  "description": "Optional equality filter on visit.kebele",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Page size (default 50)"
                },
                {
                  "key": "start",
                  "value": "0",
                  "description": "Offset (default 0)"
                }
              ]
            },
            "description": "GET /visits — visits the caller may see via Role DocPerm + User Permissions. Query args only narrow that set. Meta: { total, limit, start } (total is len of returned page).\n\nEach row carries advisory_qa[] {question, answer}: an Advisory visit's questions in the order they were saved, [] for other visit types.\n\nRead allowed by DA Visit DocType Role permissions + User Permissions."
          },
          "response": []
        },
        {
          "name": "Get visit",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/visits/{{visit_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "visits",
                "{{visit_id}}"
              ]
            },
            "description": "One visit + derived ui_status / planner_status + timeline[] built from visit timestamps. An Advisory visit also carries advisory_qa[] {question, answer}."
          },
          "response": []
        },
        {
          "name": "Reschedule visit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduled_at\": \"{{visit_date}} 15:30:00\",\n  \"reason\": \"Farmer unavailable\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/visits/{{visit_id}}/reschedule",
            "description": "Body: scheduled_at **or** date+time, plus reason.\n\nReason options (doctype): Farmer unavailable / Weather or road access / Agent schedule conflict / Inputs not yet delivered / Other.\n\nCreates a new Planned visit linked via rescheduled_from; old visit becomes Rescheduled.\n\nDependency: visit_id from Plan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = (pm.response.json() || {}).data || {};",
                  "const visitId = data.name || data.id;",
                  "if (visitId) {",
                  "  pm.collectionVariables.set(\"visit_id\", visitId);",
                  "  if (pm.environment.name) pm.environment.set(\"visit_id\", visitId);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "4. Start, outcome, evidence",
      "description": "Order: Plan → (optional Reschedule) → Start → (optional Attachments) → Submit. Uses visit_id from Plan/Reschedule. Do not Cancel that visit first.",
      "item": [
        {
          "name": "Start visit (check-in)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Start returns 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arrived_at\": \"{{visit_date}} 09:05:00\",\n  \"gps\": {\n    \"lat\": 9.0321,\n    \"lng\": 38.7470,\n    \"accuracy_m\": 12.5\n  },\n  \"farmer_present\": true,\n  \"client_op_id\": \"start-{{visit_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/visits/{{visit_id}}/start",
            "description": "Check-in. Sets physical_status = In progress.\n\nBody:\n- arrived_at (optional)\n- gps { lat, lng, accuracy_m } (optional)\n- farmer_present (default true)\n- client_op_id (optional; replay-safe if already In progress)"
          },
          "response": []
        },
        {
          "name": "Upload attachment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Attachment upload returns 200 or 201\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "postman/Visits/fixtures/plot.png",
                  "description": "Image/document file (required). Path relative to repo root for CLI; in the Desktop app pick any local image."
                },

                {
                  "key": "kind",
                  "value": "Crop",
                  "type": "text",
                  "description": "Crop / Land / Animal / Document"
                },
                {
                  "key": "lat",
                  "value": "9.0321",
                  "type": "text"
                },
                {
                  "key": "lng",
                  "value": "38.7470",
                  "type": "text"
                },
                {
                  "key": "captured_at",
                  "value": "{{visit_date}} 09:10:00",
                  "type": "text"
                },
                {
                  "key": "content_hash",
                  "value": "",
                  "type": "text",
                  "description": "Optional client hash for dedupe"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/da-services/visits/{{visit_id}}/attachments",
            "description": "multipart/form-data. Rate limit: 60/min per user. CLI uses fixtures/plot.png; in Postman Desktop pick a local file if needed."
          },
          "response": []
        },
        {
          "name": "Submit visit outcome",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Submit returns 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Field check — crop stand and input uptake\",\n  \"farmer_response\": \"Agreed to top-dress next week if rain holds\",\n  \"observed\": \"Stand looks even; mild leaf spotting on plot edge.\",\n  \"advice_given\": \"Monitor spotting; apply recommended fungicide if it spreads.\",\n  \"inputs_actions\": \"Logged pending fertilizer voucher\",\n  \"next_action\": {\n    \"type\": \"Follow-up visit\",\n    \"note\": \"Re-check leaf spotting\",\n    \"date\": \"2026-11-24\"\n  },\n  \"client_op_id\": \"outcome-{{visit_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/visits/{{visit_id}}/submit",
            "description": "Submit outcome → physical_status = Physical Visit Complete.\n\nnext_action.type: None | Follow-up visit | Task.\nFollow-up visit creates a Planned DA Visit; Task creates a DA Task.\n\nDependency: visit must be started (In progress) per doctype rules."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4b. Cancel (optional)",
      "description": "Plans a disposable visit and cancels it. Does not touch visit_id used by Start/Submit.",
      "item": [
        {
          "name": "Cancel visit",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.environment.get(\"access_token\") || pm.collectionVariables.get(\"access_token\");",
                  "const base = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
                  "const user = pm.environment.get(\"user\") || pm.collectionVariables.get(\"user\");",
                  "const day = pm.environment.get(\"visit_date\") || pm.collectionVariables.get(\"visit_date\");",
                  "const body = {",
                  "  user,",
                  "  farmer_id: \"FRM-POSTMAN-CANCEL-\" + Date.now(),",
                  "  date: day,",
                  "  time: \"16:00\",",
                  "  purpose: \"Disposable cancel sample\",",
                  "  client_op_id: \"cancel-src-\" + Date.now()",
                  "};",
                  "pm.sendRequest({",
                  "  url: base + \"/api/v1/da-services/visits\",",
                  "  method: \"POST\",",
                  "  header: {",
                  "    \"Content-Type\": \"application/json\",",
                  "    Accept: \"application/json\",",
                  "    Authorization: \"Bearer \" + token",
                  "  },",
                  "  body: { mode: \"raw\", raw: JSON.stringify(body) }",
                  "}, function (err, res) {",
                  "  if (err) { throw err; }",
                  "  const data = (res.json() || {}).data || {};",
                  "  const id = data.name || data.id;",
                  "  if (!id) { throw new Error(\"Cancel prerequest could not plan a disposable visit\"); }",
                  "  pm.collectionVariables.set(\"cancel_visit_id\", id);",
                  "  if (pm.environment.name) pm.environment.set(\"cancel_visit_id\", id);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cancel returns 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Farmer declined the visit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/visits/{{cancel_visit_id}}/cancel",
            "description": "Body: { reason }. Prerequest plans FRM-POSTMAN-CANCEL-001 so Start/Submit visit_id stays intact."
          },
          "response": []
        }
      ]
    },
    {
