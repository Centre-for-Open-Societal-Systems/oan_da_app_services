    {
      "name": "1. Add advisor (Admin)",
      "item": [
        {
          "name": "Add advisor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Add advisor returns 201\", function () { pm.response.to.have.status(201); });",
                  "const row = (pm.response.json() || {}).data || {};",
                  "pm.test(\"Returns every advisor field\", function () { pm.expect(row).to.have.all.keys([\"id\", \"name\", \"expertise\", \"unit\", \"region\", \"woreda\", \"phone\", \"email\", \"status\", \"availability\", \"updated_at\"]); });",
                  "pm.test(\"Id is ADV-nnnn\", function () { pm.expect(row.id).to.match(/^ADV-\\d+$/); });",
                  "function save(key, value) {",
                  "    if (!value) return;",
                  "    pm.collectionVariables.set(key, value);",
                  "    if (pm.environment.name) pm.environment.set(key, value);",
                  "}",
                  "save(\"advisor_id\", row.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "POST /advisors. Required: name (3+ characters), expertise, unit, region, woreda, phone (Ethiopian mobile), email. Optional: status (default Active), availability.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Hanna Girma\",\n  \"expertise\": \"Agronomy\",\n  \"unit\": \"Crop Development Directorate\",\n  \"region\": \"{{region_name}}\",\n  \"woreda\": \"{{woreda_name}}\",\n  \"phone\": \"+251 91 623 0458\",\n  \"email\": \"hanna.g@moa.gov.et\",\n  \"status\": \"Active\",\n  \"availability\": \"Mon-Fri, 08:30-17:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/advisors"
          },
          "response": []
        },
        {
          "name": "Add advisor in another Woreda",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Add advisor returns 201\", function () { pm.response.to.have.status(201); });",
                  "const row = (pm.response.json() || {}).data || {};",
                  "pm.test(\"Blank availability is filled from the status\", function () { pm.expect(row.availability).to.eql(\"Not taking requests\"); });",
                  "function save(key, value) {",
                  "    if (!value) return;",
                  "    pm.collectionVariables.set(key, value);",
                  "    if (pm.environment.name) pm.environment.set(key, value);",
                  "}",
                  "save(\"other_advisor_id\", row.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "A second advisor, outside the DA's Woreda, for the scope checks. Availability is left blank: the server fills it from the status.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meseret Haile\",\n  \"expertise\": \"Irrigation\",\n  \"unit\": \"Small-scale Irrigation Directorate\",\n  \"region\": \"{{other_region_name}}\",\n  \"woreda\": \"{{other_woreda_name}}\",\n  \"phone\": \"+251 91 623 0458\",\n  \"email\": \"meseret.h@moa.gov.et\",\n  \"status\": \"On leave\",\n  \"availability\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/da-services/advisors"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. List advisors",
      "item": [
        {
          "name": "List advisors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"List advisors returns 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json() || {};",
                  "pm.test(\"data is an array\", function () { pm.expect(body.data).to.be.an(\"array\"); });",
                  "pm.test(\"meta has total, limit, start\", function () { pm.expect(body.meta).to.include.keys([\"total\", \"limit\", \"start\"]); });",
                  "pm.test(\"Admin sees both added advisors\", function () { const ids = body.data.map(a => a.id); pm.expect(ids).to.include(pm.collectionVariables.get(\"advisor_id\")); pm.expect(ids).to.include(pm.collectionVariables.get(\"other_advisor_id\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "GET /advisors. Newest change first. Enable a query parameter to filter. meta.total is the count before paging.",
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/advisors?limit=50&start=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "advisors"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Hanna",
                  "disabled": true,
                  "description": "Searches name, id, expertise, unit, region, Woreda and email."
                },
                {
                  "key": "expertise",
                  "value": "Agronomy",
                  "disabled": true
                },
                {
                  "key": "region",
                  "value": "{{region_name}}",
                  "disabled": true
                },
                {
                  "key": "woreda",
                  "value": "{{woreda_name}}",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "Active",
                  "disabled": true,
                  "description": "Active | On leave | Inactive"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "1-500, default 50"
                },
                {
                  "key": "start",
                  "value": "0"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search by advisor id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Search returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Finds exactly that advisor\", function () { const d = (pm.response.json() || {}).data || []; pm.expect(d.length).to.eql(1); pm.expect(d[0].id).to.eql(pm.collectionVariables.get(\"advisor_id\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "q also matches the advisor id.",
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/advisors?q={{advisor_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "advisors"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{advisor_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filter by status and Woreda",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Filter returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Every row matches the filter\", function () { ((pm.response.json() || {}).data || []).forEach(a => { pm.expect(a.status).to.eql(\"On leave\"); pm.expect(a.woreda).to.eql(pm.collectionVariables.get(\"other_woreda_name\")); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "Filters are exact matches and combine with AND.",
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/advisors?status=On leave&woreda={{other_woreda_name}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "advisors"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "On leave"
                },
                {
                  "key": "woreda",
                  "value": "{{other_woreda_name}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
