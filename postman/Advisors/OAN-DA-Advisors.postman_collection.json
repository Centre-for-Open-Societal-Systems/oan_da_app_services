  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login returns 200\", function () { pm.response.to.have.status(200); });",
                  "const row = (pm.response.json() || {}).data || {};",
                  "function save(key, value) {",
                  "    if (!value) return;",
                  "    pm.collectionVariables.set(key, value);",
                  "    if (pm.environment.name) pm.environment.set(key, value);",
                  "}",
                  "save(\"access_token\", row.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Public login. Stores access_token, used by every request that does not set its own token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"{{admin_usr}}\",\n  \"pwd\": \"{{admin_pwd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "response": []
        },
        {
          "name": "Login (DA)",
          "event": [
            {
              "listen": "test",
              "script": {
