            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"{{da_usr}}\",\n  \"pwd\": \"{{da_pwd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "response": []
