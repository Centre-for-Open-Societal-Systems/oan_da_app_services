          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Closed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/surveys/templates/{{survey_id}}",
            "description": "Closes the survey. New responses are refused afterward."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Negative and security cases",
      "item": [
        {
          "name": "Get me (Executive menu includes /surveys)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Me returns 200\", function () { pm.response.to.have.status(200); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "pm.test(\"Executive sees the Surveys menu\", function () {",
                  "  pm.expect(data.menu || []).to.include(\"/surveys\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{executive_access_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/da-services/me",
            "description": "Executive nav includes /surveys; Communications Officer must not."
          },
          "response": []
        },
        {
          "name": "Invalid farmer (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unknown farmer is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Error code is NOT_FOUND\", function () {",
                  "  pm.expect((pm.response.json() || {}).code).to.eql(\"NOT_FOUND\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmer_id\": \"{{bad_farmer_id}}\",\n  \"consent\": \"granted\",\n  \"answers\": { \"p4\": \"4\", \"p5\": \"Yes, fully\" },\n  \"sync_state\": \"Synced\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/surveys/{{survey_id}}/responses",
            "description": "Farmer is resolved against the Farmer Registry / DA Farmer Reference before insert. No row is written."
          },
          "response": []
        },
        {
          "name": "Farmer outside assigned Kebele (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Out-of-Kebele farmer is 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Error code is PERMISSION_DENIED\", function () {",
                  "  pm.expect((pm.response.json() || {}).code).to.eql(\"PERMISSION_DENIED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmer_id\": \"{{outside_kebele_farmer_id}}\",\n  \"consent\": \"granted\",\n  \"answers\": { \"p4\": \"4\", \"p5\": \"Yes, fully\" },\n  \"sync_state\": \"Synced\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/surveys/{{survey_id}}/responses",
            "description": "Set outside_kebele_farmer_id to a farmer in the same Woreda but a Kebele this DA is not assigned. No row is written."
          },
          "response": []
        },
        {
          "name": "Duplicate submission from another DA (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cross-DA duplicate is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Error code is DUPLICATE_ENTRY\", function () {",
                  "  pm.expect((pm.response.json() || {}).code).to.eql(\"DUPLICATE_ENTRY\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{other_access_token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmer_id\": \"{{farmer_id}}\",\n  \"consent\": \"granted\",\n  \"answers\": { \"p4\": \"5\", \"p5\": \"Partly\" },\n  \"sync_state\": \"Synced\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/surveys/{{survey_id}}/responses",
            "description": "Same farmer + template already submitted by the first DA. The rule is cross-DA: the second DA gets 409 and no second row is stored."
          },
          "response": []
        },
        {
          "name": "Idempotency seed (fixed client_op_id)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = \"replay-\" + Date.now();",
                  "pm.collectionVariables.set(\"replay_client_op_id\", id);",
                  "if (pm.environment.name) pm.environment.set(\"replay_client_op_id\", id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Seed response returns 201\", function () { pm.response.to.have.status(201); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "if (data.id) {",
                  "  pm.collectionVariables.set(\"replay_response_id\", data.id);",
                  "  if (pm.environment.name) pm.environment.set(\"replay_response_id\", data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmer_id\": \"{{replay_farmer_id}}\",\n  \"consent\": \"granted\",\n  \"answers\": { \"p4\": \"4\", \"p5\": \"Yes, fully\" },\n  \"sync_state\": \"Synced\",\n  \"client_op_id\": \"{{replay_client_op_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/surveys/{{survey_id}}/responses",
            "description": "Set replay_farmer_id to a farmer not used by the happy-path submit. Stores replay_client_op_id and replay_response_id."
          },
          "response": []
        },
        {
          "name": "Idempotency replay (same payload → same row)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Replay returns 201\", function () { pm.response.to.have.status(201); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "pm.test(\"Replay returns the original response id\", function () {",
                  "  pm.expect(data.id).to.eql(pm.collectionVariables.get(\"replay_response_id\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmer_id\": \"{{replay_farmer_id}}\",\n  \"consent\": \"granted\",\n  \"answers\": { \"p4\": \"4\", \"p5\": \"Yes, fully\" },\n  \"sync_state\": \"Synced\",\n  \"client_op_id\": \"{{replay_client_op_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/surveys/{{survey_id}}/responses",
            "description": "Replay is scoped to the same survey + collector and compares the payload. No new row."
          },
          "response": []
        },
        {
          "name": "Idempotency replay with different payload (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mismatched replay is 409\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmer_id\": \"{{farmer_id}}\",\n  \"consent\": \"granted\",\n  \"answers\": { \"p4\": \"1\", \"p5\": \"No\" },\n  \"sync_state\": \"Synced\",\n  \"client_op_id\": \"{{replay_client_op_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/surveys/{{survey_id}}/responses",
            "description": "Same client_op_id, different farmer/payload. Returns 409 and never discloses the original response."
          },
          "response": []
        },
        {
          "name": "Export responses as XLSX (Executive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Export returns 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Export is an XLSX download\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"spreadsheetml\");",
                  "  pm.expect(pm.response.headers.get(\"Content-Disposition\") || \"\").to.include(\"attachment\");",
                  "});",
                  "const disposition = pm.response.headers.get(\"Content-Disposition\") || \"\";",
                  "const match = disposition.match(/filename=\"?([^\";]+)\"?/);",
                  "if (match) {",
                  "  pm.collectionVariables.set(\"export_filename\", match[1]);",
                  "  if (pm.environment.name) pm.environment.set(\"export_filename\", match[1]);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{executive_access_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
            ],
            "url": "{{base_url}}/api/v1/da-services/surveys/{{survey_id}}/responses/export",
            "description": "Supervisor / Executive / Admin. Returns raw workbook bytes, not the JSON envelope."
          },
          "response": []
        },
        {
          "name": "Export as DA (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"DA cannot export survey responses\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{da_access_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/da-services/surveys/{{survey_id}}/responses/export",
            "description": "Export is restricted to Supervisor, Executive and Admin. Communications Officer is also denied."
          },
          "response": []
        }
      ]
    }
