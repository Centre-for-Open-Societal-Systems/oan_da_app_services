{
  "info": {
    "_postman_id": "oan-da-attendance-punches",
    "name": "OAN DA Attendance Punches",
    "description": "Punch-in / punch-out for DA, Supervisor, and Executive.\n\nBase path: /api/v1/da-services\n\n## Run order\n1. SSO Login\n2. GET today (null → show Punch In; last Punch In → Punch Out; last Punch Out → Punch In)\n3. POST punch with action, punched_at, region, zone; optional woreda, kebele\n\n## Auth\nSSO Login → Bearer. Native DocType — no staff CSRF.\nAccess = Role DocPerm on DA Attendance Punch (no require_roles in handlers).\n\n## Notes\n- user stamped from session; da_id via fetch_from User.da_registry_id\n- region + zone required (Link masters); woreda + kebele optional\n- No punch-sequence checks on the backend\n- Datetimes are site-local ISO without offset",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8200" },
    { "key": "usr", "value": "" },
    { "key": "pwd", "value": "" },
    { "key": "sso_key", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "region", "value": "" },
    { "key": "zone", "value": "" },
    { "key": "woreda", "value": "" },
    { "key": "kebele", "value": "" },
    { "key": "punched_at", "value": "" },
    { "key": "punch_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "SSO Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"SSO Login returns 200\", function () { pm.response.to.have.status(200); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "if (data.access_token) { pm.collectionVariables.set(\"access_token\", data.access_token); pm.environment.set(\"access_token\", data.access_token); }",
                  "if (data.csrf_token) { pm.collectionVariables.set(\"csrf_token\", data.csrf_token); pm.environment.set(\"csrf_token\", data.csrf_token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usr}}\",\n  \"password\": \"{{pwd}}\",\n  \"key\": \"{{sso_key}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/sso/login",
            "description": "Stores access_token for subsequent punch calls."
          }
        }
      ]
    },
    {
      "name": "1. Today latest",
      "item": [
        {
          "name": "GET today latest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"GET today returns 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json() || {};",
                  "pm.test(\"envelope has data key\", function () { pm.expect(body).to.have.property(\"data\"); });",
                  "const data = body.data;",
                  "if (data && data.id) { pm.collectionVariables.set(\"punch_id\", data.id); pm.environment.set(\"punch_id\", data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/da-services/attendance-punches/today",
            "description": "Latest punch for the session user on the site calendar day. data is null when none."
          }
        }
      ]
    },
    {
      "name": "2. Create punch",
      "item": [
        {
          "name": "POST Punch In",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"punched_at\") && !pm.environment.get(\"punched_at\")) {",
                  "  const d = new Date();",
                  "  const pad = (n) => String(n).padStart(2, \"0\");",
                  "  const stamp = d.getFullYear() + \"-\" + pad(d.getMonth() + 1) + \"-\" + pad(d.getDate()) + \" \" + pad(d.getHours()) + \":\" + pad(d.getMinutes()) + \":\" + pad(d.getSeconds());",
                  "  pm.collectionVariables.set(\"punched_at\", stamp);",
                  "  pm.environment.set(\"punched_at\", stamp);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST Punch In returns 201\", function () { pm.response.to.have.status(201); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "pm.test(\"action is Punch In\", function () { pm.expect(data.action).to.eql(\"Punch In\"); });",
                  "if (data.id) { pm.collectionVariables.set(\"punch_id\", data.id); pm.environment.set(\"punch_id\", data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"Punch In\",\n  \"punched_at\": \"{{punched_at}}\",\n  \"region\": \"{{region}}\",\n  \"zone\": \"{{zone}}\",\n  \"woreda\": \"{{woreda}}\",\n  \"kebele\": \"{{kebele}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/attendance-punches",
            "description": "Create Punch In. Set region/zone (required). woreda/kebele optional — clear if role has no lower geo."
          }
        },
        {
          "name": "POST Punch Out",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "const pad = (n) => String(n).padStart(2, \"0\");",
                  "const stamp = d.getFullYear() + \"-\" + pad(d.getMonth() + 1) + \"-\" + pad(d.getDate()) + \" \" + pad(d.getHours()) + \":\" + pad(d.getMinutes()) + \":\" + pad(d.getSeconds());",
                  "pm.collectionVariables.set(\"punched_at\", stamp);",
                  "pm.environment.set(\"punched_at\", stamp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST Punch Out returns 201\", function () { pm.response.to.have.status(201); });",
                  "const data = (pm.response.json() || {}).data || {};",
                  "pm.test(\"action is Punch Out\", function () { pm.expect(data.action).to.eql(\"Punch Out\"); });",
                  "if (data.id) { pm.collectionVariables.set(\"punch_id\", data.id); pm.environment.set(\"punch_id\", data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"Punch Out\",\n  \"punched_at\": \"{{punched_at}}\",\n  \"region\": \"{{region}}\",\n  \"zone\": \"{{zone}}\",\n  \"woreda\": \"{{woreda}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/da-services/attendance-punches",
            "description": "Create Punch Out. Example omits kebele (Supervisor-style partial geo)."
          }
        }
      ]
    }
  ]
}
