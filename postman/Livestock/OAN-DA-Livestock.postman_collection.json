     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/da-services/farmers/{{farmer_id}}/livestock?source=register",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "da-services",
      "farmers",
      "{{farmer_id}}",
      "livestock"
     ],
     "query": [
      {
       "key": "source",
       "value": "register",
       "description": "Required. Registers tab — one staff search_in_a_register."
      }
     ]
    },
    "description": "Registers list. source=register is required. Stores internal_record_id from the first row for Register tab."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"List returns 200\", function () { pm.response.to.have.status(200); });",
       "const data = (pm.response.json() || {}).data || {};",
       "pm.test(\"source is register\", function () { pm.expect(data.source).to.eql(\"register\"); });",
       "const livestock = data.livestock || [];",
       "pm.test(\"At least one livestock row\", function () { pm.expect(livestock.length).to.be.above(0); });",
       "const first = livestock.find((row) => row && row.internal_record_id) || livestock[0] || {};",
       "function save(key, value) {",
       "    if (!value) return;",
       "    pm.collectionVariables.set(key, value);",
       "    if (pm.environment.name) pm.environment.set(key, value);",
       "}",
       "save(\"internal_record_id\", first.internal_record_id);"
      ]
     }
    }
   ],
