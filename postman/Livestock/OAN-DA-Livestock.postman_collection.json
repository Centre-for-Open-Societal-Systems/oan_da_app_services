 "item": [
  {
   "name": "Login",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Accept",
      "value": "application/json"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/auth/login",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "auth",
      "login"
     ]
    },
    "description": "Local DA Services login. Stores access_token and refresh_token. Livestock calls also need the SSO token and csrf_token; see the collection description.",
    "auth": {
     "type": "noauth"
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"usr\": \"{{usr}}\",\n  \"pwd\": \"{{pwd}}\"\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"Login returns 200\", function () { pm.response.to.have.status(200); });",
       "const data = (pm.response.json() || {}).data || {};",
       "function save(key, value) {",
       "    if (!value) return;",
       "    pm.collectionVariables.set(key, value);",
       "    if (pm.environment.name) pm.environment.set(key, value);",
       "}",
       "save(\"access_token\", data.access_token);",
       "save(\"refresh_token\", data.refresh_token);"
      ]
     }
    }
   ]
  },
  {
   "name": "Refresh token",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Accept",
      "value": "application/json"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/auth/refresh",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "auth",
      "refresh"
     ]
    },
    "description": "Keep the new refresh_token it returns.",
    "auth": {
     "type": "noauth"
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "if (!pm.variables.get(\"refresh_token\")) pm.execution.skipRequest();"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"Refresh token returns 200\", function () { pm.response.to.have.status(200); });",
       "const data = (pm.response.json() || {}).data || {};",
       "function save(key, value) {",
       "    if (!value) return;",
       "    pm.collectionVariables.set(key, value);",
       "    if (pm.environment.name) pm.environment.set(key, value);",
       "}",
       "save(\"access_token\", data.access_token);",
       "save(\"refresh_token\", data.refresh_token);"
      ]
     }
    }
   ]
  },
