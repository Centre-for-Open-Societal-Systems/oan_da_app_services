      "farmers",
      "{{farmer_id}}",
      "livestock"
     ]
    },
    "description": "Full section rows for this farmer: submissions include sections, and records include the register columns (ear tag, species, holding, health, vaccination, vital, breeding). Not the search display_fields list."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "const rows = (((pm.response.json() || {}).data || {}).livestock) || [];",
       "pm.test(\"List farmer livestock returns full section rows\", function () {",
       "    pm.response.to.have.status(200);",
       "    pm.expect(rows.length).to.be.above(0);",
       "    const animal = rows.find(row => row.kind === \"record\" && row.ear_tag_id && row.breed);",
       "    pm.expect(animal, \"an animal row with ear_tag_id\").to.be.an(\"object\");",
       "    pm.expect(animal.species).to.be.a(\"string\").that.is.not.empty;",
       "    pm.expect(animal.breed).to.be.a(\"string\").that.is.not.empty;",
       "    pm.expect(animal.gender).to.be.a(\"string\").that.is.not.empty;",
       "    pm.expect(animal.health_status).to.be.a(\"string\").that.is.not.empty;",
       "    const holding = rows.find(row => row.kind === \"record\" && row.farmer_id);",
       "    pm.expect(holding, \"a holding row\").to.be.an(\"object\");",
       "    pm.expect(holding.farmer_name).to.be.a(\"string\").that.is.not.empty;",
       "    const submission = rows.find(row => row.kind === \"submission\");",
       "    if (submission) pm.expect(submission.sections).to.be.an(\"array\");",
       "});"
      ]
     }
    }
   ],
