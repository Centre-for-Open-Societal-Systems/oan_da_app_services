  {
   "name": "Read regions",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Accept",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/da-services/livestock/geo-level-values?level_id=l1",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "da-services",
      "livestock",
      "geo-level-values"
     ],
     "query": [
      {
       "key": "level_id",
       "value": "l1",
       "description": "l1 region, l2 zone, l3 woreda, l4 kebele"
      }
     ]
    },
    "description": "Level l1. Stores the first region's level_value_id. Rows also carry level_value_mnemonic (shortened here)."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"Read regions returns 200\", function () { pm.response.to.have.status(200); });",
       "const values = (((pm.response.json() || {}).data || {}).values) || [];",
       "function save(key, value) {",
       "    if (!value) return;",
       "    pm.collectionVariables.set(key, value);",
       "    if (pm.environment.name) pm.environment.set(key, value);",
       "}",
       "if (values.length) save(\"region_level_value_id\", values[0].level_value_id);"
      ]
     }
    }
