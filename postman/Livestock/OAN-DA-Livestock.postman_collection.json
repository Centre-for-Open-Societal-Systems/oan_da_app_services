{
 "info": {
  "_postman_id": "oan-da-livestock",
  "name": "OAN DA Livestock",
  "description": "DA Services Livestock routes. Every request sends Authorization: Bearer {{access_token}} and, when csrf_token is set, X-CSRF-Token: {{csrf_token}}. DA Services forwards both to the Livestock staff host, so put the SSO (Keycloak) staff token in access_token and its CSRF value in csrf_token. Save stores submission_id and subject_record_id. Example responses are shortened reads from the development hosts on 2026-11-02. Guide: docs/livestock-integration.md.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{access_token}}",
    "type": "string"
   }
  ]
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "const csrf = pm.variables.get(\"csrf_token\");",
     "if (csrf) pm.request.headers.upsert({ key: \"X-CSRF-Token\", value: csrf });"
    ]
   }
  }
 ],
 "variable": [
