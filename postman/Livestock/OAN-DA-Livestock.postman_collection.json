      "{{farmer_id}}",
      "livestock"
     ]
    },
    "description": "New draft: farmer lookup (farmer_id is filled from the URL), survey personnel, location, one animal. Species and breed store value_id (CATTLE, BREED_LOCAL). Sex, health and vaccination store value_code (SEX_FEMALE, HEALTHY, UP_TO_DATE). Stores submission_id and subject_record_id.",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"submission_id\": null,\n  \"sections\": [\n    {\n      \"section_id\": \"livestock_farmer_lookup\",\n      \"records\": [\n        {\n          \"fayda_id\": \"{{fayda_id}}\"\n        }\n      ]\n    },\n    {\n      \"section_id\": \"livestock_survey_personnel_section_02\",\n      \"records\": [\n        {\n          \"surveyor_name\": \"Abebe Kebede\",\n          \"surveyor_mobile_number\": \"0911223344\"\n        }\n      ]\n    },\n    {\n      \"section_id\": \"livestock_livestock_location_section_03\",\n      \"records\": [\n        {\n          \"geo_lowest_level_value_id\": \"{{kebele_level_value_id}}\"\n        }\n      ]\n    },\n    {\n      \"section_id\": \"livestock_animal_details_section_01\",\n      \"records\": [\n        {\n          \"ear_tag_id\": \"{{ear_tag_id}}\",\n          \"species\": \"CATTLE\",\n          \"breed\": \"BREED_LOCAL\",\n          \"gender\": \"SEX_FEMALE\",\n          \"date_of_birth\": \"2021-05-14\",\n          \"weight\": 312.5,\n          \"health_status\": \"HEALTHY\",\n          \"vaccination_status\": \"UP_TO_DATE\",\n          \"registration_date\": \"2026-11-02\"\n        }\n      ]\n    }\n  ]\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
