{
 "info": {
  "_postman_id": "oan-da-livestock",
  "name": "OAN DA Livestock",
  "description": "DA Services Livestock routes. Prerequisites: Desk DA Services Settings must set livestock_registry_domain and livestock_registry_form_register_id (required; no get_all_registers). List requires source=submission|register (one staff search). List farmer livestock (source=register) stores internal_record_id; Register tab reuses it with tab_id (one get_tab_records). Every request sends Authorization: Bearer {{access_token}} and X-CSRF-Token: {{csrf_token}} (forwarded to Livestock staff). Save stores submission_id and subject_record_id. Guide: docs/livestock-integration.md.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{access_token}}",
    "type": "string"
   }
  ]
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "const csrf = pm.variables.get(\"csrf_token\");",
     "if (csrf) pm.request.headers.upsert({ key: \"X-CSRF-Token\", value: csrf });"
    ]
   }
  }
 ],
