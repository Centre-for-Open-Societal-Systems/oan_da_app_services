    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"Save main sections and an animal returns 200\", function () { pm.response.to.have.status(200); });",
       "const data = (pm.response.json() || {}).data || {};",
       "function save(key, value) {",
       "    if (!value) return;",
       "    pm.collectionVariables.set(key, value);",
       "    if (pm.environment.name) pm.environment.set(key, value);",
       "}",
       "save(\"submission_id\", data.submission_id);",
       "save(\"subject_record_id\", data.subject_record_id);"
      ]
     }
    }
