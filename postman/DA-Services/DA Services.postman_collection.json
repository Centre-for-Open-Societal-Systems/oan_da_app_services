      "name": "0. Auth",
      "item": [
        {
          "name": "SSO Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "",
                  "if (jsonData && jsonData.data) {",
                  "    pm.environment.set(\"access_token\", jsonData.data.access_token);",
                  "    pm.environment.set(\"csrf_token\", jsonData.data.csrf_token);",
                  "    console.log(\"access_token and csrf_token stored in environment.\");",
                  "} else {",
                  "    console.error(\"Unexpected response structure:\", jsonData);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"da-agent@services.com\",\n    \"password\": \"admin@123\",\n    \"key\": \"agent\"\n  }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}api/v1/da-services/sso/login",
              "host": [
                "{{base_url}}api"
              ],
              "path": [
                "v1",
                "da-services",
                "sso",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
