            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}api/v1/da-services/get_master_data?data_type=geo&field_name=region&parent=ET&current_page=1&page_size=100&search",
              "host": [
                "{{base_url}}api"
              ],
              "path": [
                "v1",
                "da-services",
                "get_master_data"
              ],
              "query": [
                {
                  "key": "data_type",
                  "value": "geo",
                  "description": "geo or attribute"
                },
                {
                  "key": "field_name",
                  "value": "region",
                  "description": "CROP_COMMODITY"
                },
                {
                  "key": "parent",
                  "value": "ET"
                },
                {
                  "key": "current_page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "100"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
