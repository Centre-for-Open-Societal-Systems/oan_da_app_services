  "item": [
    {
      "name": "SSO Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{usr}}\",\n  \"password\": \"{{pwd}}\",\n  \"key\": \"{{sso_key}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/da-services/sso/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "da-services",
            "sso",
            "login"
          ]
        },
        "description": "Required login. Same as: POST /api/v1/da-services/sso/login with username, password, key. Defaults match local curl (da-agent@services.com / admin@123 / agent). Stores access_token and csrf_token for Bearer + X-CSRF-Token on later requests."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"SSO Login returns 200\", function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json() || {};",
              "const data = jsonData.data || {};",
              "pm.test(\"SSO Login returns access_token and csrf_token\", function () {",
              "    pm.expect(data.access_token, \"data.access_token\").to.be.a(\"string\").and.not.empty;",
              "    pm.expect(data.csrf_token, \"data.csrf_token\").to.be.a(\"string\").and.not.empty;",
              "});",
              "function save(key, value) {",
              "    if (!value) return;",
              "    pm.collectionVariables.set(key, value);",
              "    if (pm.environment.name) pm.environment.set(key, value);",
              "}",
              "save(\"access_token\", data.access_token);",
              "save(\"csrf_token\", data.csrf_token);"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "SSO Login success",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/da-services/sso/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "da-services",
                "sso",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usr}}\",\n  \"password\": \"{{pwd}}\",\n  \"key\": \"{{sso_key}}\"\n}"
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"success\",\n  \"message\": \"Success\",\n  \"data\": {\n    \"access_token\": \"ACCESS_TOKEN\",\n    \"csrf_token\": \"CSRF_TOKEN\",\n    \"user\": {\n      \"first_name\": \"DA\",\n      \"last_name\": \"Agent\",\n      \"login_option\": \"agent\",\n      \"roles\": [\n        \"A2C Development Agent\",\n        \"Development Agent\"\n      ],\n      \"profiles\": {\n        \"da_services\": {\n          \"roles\": [\n            \"Development Agent\"\n          ],\n          \"scope\": {\n            \"da_ids\": [\n              \"DA-5167618350\"\n            ],\n            \"regions\": [\n              \"ET01\"\n            ],\n            \"zones\": [\n              \"ET0101\"\n            ],\n            \"woredas\": [\n              \"ET010108\"\n            ]\n          }\n        }\n      },\n      \"user\": \"user@iam.internal\"\n    }\n  },\n  \"meta\": {\n    \"api_version\": \"v1\"\n  },\n  \"request_id\": \"00000000-0000-4000-8000-000000000001\"\n}"
        }
