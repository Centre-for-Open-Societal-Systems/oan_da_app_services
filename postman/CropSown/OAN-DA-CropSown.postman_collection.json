  "item": [
    {
      "name": "Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usr\": \"{{usr}}\",\n  \"pwd\": \"{{pwd}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/auth/login",
        "description": "Public login. Stores access_token and refresh_token. Leave usr and pwd in the environment."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login returns 200\", function () { pm.response.to.have.status(200); });",
              "const data = (pm.response.json() || {}).data || {};",
              "function save(key, value) {",
              "    if (!value) return;",
              "    pm.collectionVariables.set(key, value);",
              "    if (pm.environment.name) pm.environment.set(key, value);",
              "}",
              "save(\"access_token\", data.access_token);",
              "save(\"refresh_token\", data.refresh_token);"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Login success",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"{{usr}}\",\n  \"pwd\": \"{{pwd}}\"\n}"
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"success\",\n  \"message\": \"Success\",\n  \"data\": {\n    \"access_token\": \"ACCESS_TOKEN\",\n    \"refresh_token\": \"REFRESH_TOKEN\",\n    \"token_type\": \"Bearer\",\n    \"expires_in\": 3600\n  },\n  \"meta\": {\n    \"api_version\": \"v1\"\n  }\n}"
        }
      ]
    },
