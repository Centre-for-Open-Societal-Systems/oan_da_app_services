        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Intake form returns 200\", function () { pm.response.to.have.status(200); });",
              "const data = (pm.response.json() || {}).data || {};",
              "pm.test(\"Form mnemonic matches\", function () { pm.expect(String(data.form_mnemonic || \"\").toLowerCase()).to.include(\"planning\"); });",
              "pm.test(\"Only the requested form\", function () { pm.expect((data.intake_forms || []).length).to.eql(1); });"
