  "_comment_read": "Reads use the OpenG2P Staff API (POST + request_header/request_body envelope): register-data/get_subject_record, get_tab_records, search_in_a_register; updates become change-requests/create_change_request. No per-endpoint path config.",

  "_comment_ingest": "Farmer register / intake form / tab ids. Values are the dev FARMER_ODK_MODEL set; confirm per environment.",
  "farmer_registry_ingest": {
    "data_model": "FARMER_ODK_MODEL",
    "register_id": "a1a4d25a-1cd4-4356-abac-985a0b3c6bcd",
    "intake_form_id": "a1a4d25a-1cd4-4356-abac-8782382649",
    "tabs": {
      "farmer": "farmer_farmer_tab",
      "location": "farmer_location_tab",
      "household": "farmer_household_link_tab",
      "land": "farmer_land_tab",
      "crop": "farmer_crop_tab",
      "livestock": "farmer_livestock_tab"
    }
  },

  "_comment_keycloak": "Prefer staff-user IAM login when username and password are set (callback cookies X-Access-Token and X-CSRF-Token; login_provider_id defaults to 1). Otherwise client_credentials (token_url, client_id, client_secret) or farmer_registry_api_key. Put username and password only in site_config.json.",
  "farmer_registry_keycloak": {
    "iam_base_url": "https://staff-iam.development.oanstaging.com",
    "kc_realm_url": "https://keycloak.development.oanstaging.com/realms/staff",
    "login_provider_id": "1",
    "token_url": "https://keycloak.development.oanstaging.com/realms/staff/protocol/openid-connect/token",
    "client_id": "da-services",
    "client_secret": "ask-asmit-for-dev-secret"
  },

  "_comment_environments": "Documentation only. The client reads the top-level keys from site_config.json and does not load _environments.",
